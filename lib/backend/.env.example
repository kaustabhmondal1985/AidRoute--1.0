# AidRoute Backend Environment Variables
# Copy this file to .env and fill in your actual API keys

# Groq API Key (required for AI agents)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API Key (optional, for additional AI features)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (optional, for database persistence)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# SMTP Configuration (optional, for appointment email notifications)
# Get your SMTP credentials from your email provider
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
DEFAULT_LAWYER_EMAIL=lawyer@aidroute.org
